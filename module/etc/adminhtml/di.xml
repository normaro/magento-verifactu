<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Verifactu block right after "Invoice / Credit Memo Information" on the admin view pages -->
    <type name="Magento\Sales\Block\Adminhtml\Order\View\Info">
        <plugin name="normaro_verifactu_document_block_position"
                type="Normaro\Verifactu\Plugin\AdminDocumentBlockPosition"/>
    </type>
    <!-- "Send Email" on the invoice / credit memo page always sends, issued or not -->
    <type name="Magento\Sales\Controller\Adminhtml\Invoice\AbstractInvoice\Email">
        <plugin name="normaro_verifactu_manual_email" type="Normaro\Verifactu\Plugin\ManualSendEmail"/>
    </type>
    <type name="Magento\Sales\Controller\Adminhtml\Creditmemo\AbstractCreditmemo\Email">
        <plugin name="normaro_verifactu_manual_email" type="Normaro\Verifactu\Plugin\ManualSendEmail"/>
    </type>
</config>
